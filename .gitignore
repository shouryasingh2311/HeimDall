*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
dist-ssr/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
env/
venv/
ENV/

# Runtime data & private demo directories
.heimdal/
.cicada/

# Secrets, TLS Certificates, & Keys
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.crt
*.csr
*.token
*.secret

# Local databases & SQLite locks
*.db
*.db-wal
*.db-shm
*.sqlite*
*.wal

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend builds
node_modules/
.npm
frontend/node_modules/
frontend/dist/

# Planning scratchpads & prompt instructions
.planning/
.claude/
*.pdf
evaluation_guide_extracted.txt
research.md

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
